# ============================================================
# selenium_traffic_system 环境变量配置模板
# 使用方法：复制为 .env 文件并填入真实值
#   cp .env.example .env
# ============================================================

# IPDeep 代理凭据（直连 API）
# IP_PROXY_API: IPDeep API URL
# IP_PROXY_USER/IP_PROXY_PWD: 访问 IPDeep API 的 Basic Auth 认证
IP_PROXY_API=https://api.ipdeep.com/api/
IP_PROXY_USER=your_proxy_user_here
IP_PROXY_PWD=your_proxy_password_here

# Flask Web UI 认证
FLASK_AUTH_USER=admin
FLASK_AUTH_PASS=your_web_password_here
FLASK_SECRET_KEY=change_me_to_a_random_string

# 运行端口
RUN_PORT=5001

# ChromeDriver 路径（留空则使用 Selenium Manager 自动管理）
CHROMEDRIVER_PATH=
